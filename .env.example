# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env
#
# .env está en .gitignore: nunca se sube al repo.
# En Supabase: Project Settings -> API.
#   - URL: https://<proyecto>.supabase.co
#   - Publishable key: llave publica (frontend y seed.js).
# La llave SECRETA (service_role / sb_secret_...) NO va aqui: solo se usa en
# scripts de administracion del servidor y nunca en el navegador.

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
